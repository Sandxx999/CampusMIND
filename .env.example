# ==============================================================================
# CampusMIND 2.0 Environment Configuration Template
# ==============================================================================

# Application Environment: 'development', 'test', or 'production'
# In 'production', DEMO_MODE must be false, JWT_SECRET_KEY must be >= 32 chars,
# and GEMINI_API_KEY + CORS_ORIGINS must be explicitly configured.
APP_ENV=development

# Demo Mode: Allows test accounts (student1, faculty1, admin1). Must be false in production.
DEMO_MODE=true
DEMO_PASSWORD=password123

# Security & Tokens
# Secret key used for signing JWT access tokens (auto-generated in dev if blank)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI Models & External Providers
# Google Gemini API Key for LLM answer generation
GEMINI_API_KEY=
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Infrastructure Paths
DATABASE_URL=sqlite:///./backend/campusmind.db
CHROMA_DB_DIR=./backend/chroma_db

# API Operations & Safeguards
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.25
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
