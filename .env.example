# Development-only defaults. Never use DEMO_MODE=true in production.
APP_ENV=development
DEMO_MODE=true
DEMO_PASSWORD=password123

# Leave blank in local development to generate an ephemeral JWT key at startup.
JWT_SECRET_KEY=
GEMINI_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

DATABASE_URL=sqlite:///./backend/campusmind.db
CHROMA_DB_DIR=./backend/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.25
RATE_LIMIT_PER_MINUTE=60
